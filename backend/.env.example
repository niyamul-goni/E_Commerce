PROJECT_NAME="E-Commerce Management System"
API_V1_STR="/api/v1"

# ── Supabase ────────────────────────────────────────────────────────────────
# All values below are from: Supabase Dashboard → Project Settings → API
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_ANON_KEY="<your-anon-public-key>"
SUPABASE_SERVICE_ROLE_KEY="<your-service-role-secret-key>"

# Manager uploads use shared Supabase Storage when these credentials are
# configured, so images remain visible on every developer/deployment machine.
# "auto" falls back to backend/static/products only when Supabase is unavailable.
PRODUCT_IMAGE_STORAGE="auto"
SUPABASE_STORAGE_BUCKET="product-images"

# Supabase Postgres Direct Connection
# From: Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Use the "psycopg2" format: postgresql+psycopg2://postgres:<password>@db.<ref>.supabase.co:5432/postgres
SUPABASE_DATABASE_URL="postgresql+psycopg2://postgres:<password>@db.<your-project-ref>.supabase.co:5432/postgres"

# Leave DATABASE_URL empty — it auto-resolves from SUPABASE_DATABASE_URL above.
# Only set this explicitly if you want to override (e.g., for local dev).
DATABASE_URL=""
INITIALIZE_DATABASE_ON_STARTUP=false

# ── Security ─────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="change-me-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# ── CORS ─────────────────────────────────────────────────────────────────────
# Add your frontend URLs (Vite default is 5173, CRA default is 3000)
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173", "http://127.0.0.1:5173"]'
